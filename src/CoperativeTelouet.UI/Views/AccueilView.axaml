<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels"
             x:Class="CoperativeTelouet.UI.Views.AccueilView"
             x:DataType="vm:AccueilViewModel">
  <Border Margin="16" Padding="24" Background="White" CornerRadius="8"
          BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrandBlack}" />
      <TextBlock Text="Bienvenue — GIE Pomme Telouet"
                 Foreground="{DynamicResource BrandGreen}" />
    </StackPanel>
  </Border>
</UserControl>
