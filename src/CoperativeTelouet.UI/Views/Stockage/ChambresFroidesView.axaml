<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels.Stockage"
             x:Class="CoperativeTelouet.UI.Views.Stockage.ChambresFroidesView"
             x:DataType="vm:ChambresFroidesViewModel">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Content="Nouveau" Command="{Binding NouveauCommand}" Padding="16,8" />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Chambres froides"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrandBlack}" />
        <TextBlock Text="Capacité et disponibilité des chambres"
                   Foreground="{DynamicResource BrandGreen}" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="16">
      <Border Grid.Column="0" Padding="16" Background="White" CornerRadius="8"
              BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Id" Binding="{Binding Id, Mode=OneWay}" Width="50" />
            <DataGridTextColumn Header="Nom" Binding="{Binding Nom, Mode=OneWay}" Width="*" />
            <DataGridTextColumn Header="Capacité" Binding="{Binding CapaciteBacs, Mode=OneWay}" Width="100" />
            <DataGridTextColumn Header="Actif" Binding="{Binding ActifLabel, Mode=OneWay}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Column="1" Padding="16" Background="White" CornerRadius="8"
              BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Détail" FontWeight="SemiBold" FontSize="16" />
          <TextBox Watermark="Nom de la chambre" Text="{Binding Nom}" />
          <TextBox Watermark="Capacité (bacs)" Text="{Binding CapaciteText}" />
          <CheckBox Content="Actif" IsChecked="{Binding Actif}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Enregistrer"
                    Classes="accent-green"
                    Command="{Binding EnregistrerCommand}" />
            <Button Content="Supprimer"
                    Command="{Binding SupprimerCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding StatusHint}"
               Opacity="0.55"
               FontSize="12" />
  </Grid>
</UserControl>
