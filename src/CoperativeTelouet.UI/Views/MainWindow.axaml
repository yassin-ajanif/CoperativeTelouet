<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CoperativeTelouet.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="CoperativeTelouet.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GIE Pomme Telouet — Gestion Commerciale"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="560"
        Background="{DynamicResource BrandSurface}">

  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top"
            Padding="12,8"
            Background="{DynamicResource BrandRed}"
            BorderBrush="{DynamicResource BrandGreen}"
            BorderThickness="0,0,0,3">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://CoperativeTelouet.UI/Assets/gie-logo.png"
                 Width="36" Height="36"
                 Stretch="Uniform" />
          <TextBlock Text="GIE Pomme Telouet"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="White"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="White"
                   Opacity="0.85"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Sidebar -->
    <Border DockPanel.Dock="Left"
            Width="220"
            Background="{DynamicResource BrandSidebar}"
            BorderBrush="{DynamicResource BrandBorder}"
            BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,12" Spacing="4">
          <TextBlock Text="Menu"
                     Margin="8,0,8,8"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource BrandBlack}"
                     Opacity="0.55" />

          <Button Classes="nav"
                  Classes.selected="{Binding IsAccueilSelected}"
                  Content="Accueil"
                  Command="{Binding NavigateToAccueilCommand}" />

          <!-- Vente -->
          <Button Classes="nav-section"
                  Command="{Binding ToggleVenteCommand}">
            <DockPanel>
              <TextBlock Text="{Binding VenteChevron}"
                         DockPanel.Dock="Left"
                         Width="16"
                         FontSize="10"
                         VerticalAlignment="Center" />
              <TextBlock Text="Vente" VerticalAlignment="Center" />
            </DockPanel>
          </Button>

          <StackPanel Spacing="4"
                      Margin="12,0,0,0"
                      IsVisible="{Binding IsVenteExpanded}">
            <Button Classes="nav"
                    Classes.selected="{Binding IsClientsSelected}"
                    Content="Clients"
                    Command="{Binding NavigateToClientsCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsDevisSelected}"
                    Content="Devis"
                    Command="{Binding NavigateToDevisCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsCommandeSelected}"
                    Content="Bons de commande"
                    Command="{Binding NavigateToBonsCommandeCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsLivraisonSelected}"
                    Content="Bons de livraison"
                    Command="{Binding NavigateToBonsLivraisonCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsFacturationSelected}"
                    Content="Facturation"
                    Command="{Binding NavigateToFacturationCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsAvoirsSelected}"
                    Content="Avoirs"
                    Command="{Binding NavigateToAvoirsCommand}" />
          </StackPanel>

          <!-- Achat -->
          <Button Classes="nav-section"
                  Command="{Binding ToggleAchatCommand}">
            <DockPanel>
              <TextBlock Text="{Binding AchatChevron}"
                         DockPanel.Dock="Left"
                         Width="16"
                         FontSize="10"
                         VerticalAlignment="Center" />
              <TextBlock Text="Achat" VerticalAlignment="Center" />
            </DockPanel>
          </Button>

          <StackPanel Spacing="4"
                      Margin="12,0,0,0"
                      IsVisible="{Binding IsAchatExpanded}">
            <Button Classes="nav"
                    Classes.selected="{Binding IsFournisseursSelected}"
                    Content="Fournisseurs"
                    Command="{Binding NavigateToFournisseursCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsDevisAchatSelected}"
                    Content="Devis"
                    Command="{Binding NavigateToDevisAchatCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsCommandeAchatSelected}"
                    Content="Bons de commande"
                    Command="{Binding NavigateToBonsCommandeAchatCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsReceptionSelected}"
                    Content="Bons de réception"
                    Command="{Binding NavigateToBonsReceptionCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsFacturationAchatSelected}"
                    Content="Facturation achat"
                    Command="{Binding NavigateToFacturationAchatCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsAvoirFournisseurSelected}"
                    Content="Avoir fournisseur"
                    Command="{Binding NavigateToAvoirFournisseurCommand}" />
          </StackPanel>

          <!-- Stockage -->
          <Button Classes="nav-section"
                  Command="{Binding ToggleStockageCommand}">
            <DockPanel>
              <TextBlock Text="{Binding StockageChevron}"
                         DockPanel.Dock="Left"
                         Width="16"
                         FontSize="10"
                         VerticalAlignment="Center" />
              <TextBlock Text="Stockage" VerticalAlignment="Center" />
            </DockPanel>
          </Button>

          <StackPanel Spacing="4"
                      Margin="12,0,0,0"
                      IsVisible="{Binding IsStockageExpanded}">
            <Button Classes="nav"
                    Classes.selected="{Binding IsStockageDashboardSelected}"
                    Content="Tableau de bord"
                    Command="{Binding NavigateToStockageDashboardCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsEntreeSelected}"
                    Content="Entrées"
                    Command="{Binding NavigateToBonsEntreeCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsBonsSortieSelected}"
                    Content="Sorties"
                    Command="{Binding NavigateToBonsSortieCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsChambresFroidesSelected}"
                    Content="Chambres"
                    Command="{Binding NavigateToChambresFroidesCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsVarietesPommeSelected}"
                    Content="Variétés"
                    Command="{Binding NavigateToVarietesPommeCommand}" />
          </StackPanel>

          <!-- Catalogue (existing CRUD) -->
          <Button Classes="nav-section"
                  Command="{Binding ToggleCatalogueCommand}">
            <DockPanel>
              <TextBlock Text="{Binding CatalogueChevron}"
                         DockPanel.Dock="Left"
                         Width="16"
                         FontSize="10"
                         VerticalAlignment="Center" />
              <TextBlock Text="Catalogue" VerticalAlignment="Center" />
            </DockPanel>
          </Button>

          <StackPanel Spacing="4"
                      Margin="12,0,0,0"
                      IsVisible="{Binding IsCatalogueExpanded}">
            <Button Classes="nav"
                    Classes.selected="{Binding IsCategoriesSelected}"
                    Content="Catégories"
                    Command="{Binding NavigateToCategoriesCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsProduitsSelected}"
                    Content="Produits"
                    Command="{Binding NavigateToProduitsCommand}" />
            <Button Classes="nav"
                    Classes.selected="{Binding IsServicesSelected}"
                    Content="Services"
                    Command="{Binding NavigateToServicesCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Content -->
    <ContentControl Content="{Binding CurrentPage}" />
  </DockPanel>
</Window>
