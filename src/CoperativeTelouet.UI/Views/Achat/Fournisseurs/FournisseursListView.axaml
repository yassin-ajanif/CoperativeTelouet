<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels.Achat.Fournisseurs"
             xmlns:conv="using:CoperativeTelouet.UI.Converters"
             x:Class="CoperativeTelouet.UI.Views.Achat.Fournisseurs.FournisseursListView"
             x:DataType="vm:FournisseursListViewModel">

  <Border Margin="16" Padding="16" Background="White" CornerRadius="8"
          BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Nouveau"
                  Classes="accent"
                  Command="{Binding NouveauCommand}"
                  Padding="16,8" />
          <Button Content="Activer/Désactiver"
                  Command="{Binding ToggleActifCommand}"
                  Padding="16,8" />
        </StackPanel>
        <TextBox Watermark="Recherche"
                 Text="{Binding SearchText}"
                 Width="280"
                 HorizontalAlignment="Left" />
      </DockPanel>

      <DataGrid Grid.Row="1"
                ItemsSource="{Binding PageItems}"
                SelectedItem="{Binding SelectedItem}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                DoubleTapped="OnRowDoubleTapped">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" />
          <DataGridTextColumn Header="ICE" Binding="{Binding ICE}" Width="140" />
          <DataGridTextColumn Header="Ville" Binding="{Binding Ville}" Width="140" />
          <DataGridTextColumn Header="Actif"
                             Binding="{Binding Actif, Converter={x:Static conv:ActifToTextConverter.Instance}}"
                             Width="100" />
        </DataGrid.Columns>
      </DataGrid>

      <DockPanel Grid.Row="2">
        <TextBlock Text="{Binding CountLabel}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource BrandBlack}"
                   Opacity="0.7" />
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center">
          <Button Content="◀"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoPrevious}"
                  Padding="10,4" />
          <TextBlock Text="{Binding PageLabel}"
                     VerticalAlignment="Center"
                     MinWidth="48"
                     TextAlignment="Center" />
          <Button Content="▶"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoNext}"
                  Padding="10,4" />
        </StackPanel>
      </DockPanel>

      <TextBlock Grid.Row="3"
                 Text="{Binding ErrorMessage}"
                 Foreground="IndianRed"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}" />
    </Grid>
  </Border>
</UserControl>
