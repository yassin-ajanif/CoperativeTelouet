<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels.Achat.Facturation"
             xmlns:dto="using:CoperativeTelouet.Business.DTOs"
             xmlns:cdto="using:CoperativeTelouet.Business.DTOs.Client"
             x:Name="Root"
             x:Class="CoperativeTelouet.UI.Views.Achat.Facturation.FacturationAchatDetailView"
             x:DataType="vm:FacturationAchatDetailViewModel">

  <Border Margin="16" Padding="16" Background="White" CornerRadius="8"
          BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
      <DockPanel Grid.Row="0">
        <Button DockPanel.Dock="Left"
                Content="Retour liste"
                Command="{Binding RetourListeCommand}"
                Padding="12,6" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Enregistrer"
                  Classes="accent-green"
                  Command="{Binding SaveCommand}"
                  Padding="16,8" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatutLabel}" Opacity="0.6" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Date" Opacity="0.7" FontSize="12" />
          <CalendarDatePicker SelectedDate="{Binding DateDocument}" Width="160" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Échéance" Opacity="0.7" FontSize="12" />
          <CalendarDatePicker SelectedDate="{Binding DateEcheance}" Width="160" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Fournisseur" Opacity="0.7" FontSize="12" />
          <ComboBox ItemsSource="{Binding FournisseurOptions}"
                    SelectedItem="{Binding SelectedFournisseur}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="dto:TiersDto">
                <TextBlock Text="{Binding Nom}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <DockPanel Grid.Row="0">
          <Button DockPanel.Dock="Right"
                  Content="Supprimer ligne"
                  Command="{Binding RemoveSelectedLigneCommand}"
                  Padding="12,6"
                  Margin="8,0,0,0" />
          <Grid>
            <TextBox Watermark="Rechercher un article (réf. ou désignation)"
                     Text="{Binding ArticleSearch}"
                     HorizontalAlignment="Stretch" />
          </Grid>
        </DockPanel>

        <Border Grid.Row="1"
                IsVisible="{Binding ShowSuggestions}"
                BorderBrush="{DynamicResource BrandBorder}"
                BorderThickness="1"
                CornerRadius="4"
                MaxHeight="160"
                Background="White">
          <ListBox ItemsSource="{Binding ArticleSuggestions}"
                   MaxHeight="160">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="cdto:ArticleSuggestionDto">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,6"
                        Command="{Binding #Root.((vm:FacturationAchatDetailViewModel)DataContext).AddArticleCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock>
                    <Run Text="{Binding Reference}" FontWeight="SemiBold" />
                    <Run Text=" — " />
                    <Run Text="{Binding Designation}" />
                    <Run Text=" (" />
                    <Run Text="{Binding PrixUnitaireHT, StringFormat=N2}" />
                    <Run Text=" HT)" />
                  </TextBlock>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
          <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <CheckBox Content="Réf." IsChecked="{Binding ShowColRef}" Margin="0,0,8,0" />
            <CheckBox Content="Désignation" IsChecked="{Binding ShowColDesignation}" Margin="0,0,8,0" />
            <CheckBox Content="Qté" IsChecked="{Binding ShowColQte}" Margin="0,0,8,0" />
            <CheckBox Content="Prix" IsChecked="{Binding ShowColPrix}" Margin="0,0,8,0" />
            <CheckBox Content="Remise" IsChecked="{Binding ShowColRemise}" Margin="0,0,8,0" />
            <CheckBox Content="TVA" IsChecked="{Binding ShowColTva}" Margin="0,0,8,0" />
            <CheckBox Content="HT" IsChecked="{Binding ShowColHt}" Margin="0,0,8,0" />
            <CheckBox Content="TTC" IsChecked="{Binding ShowColTtc}" Margin="0,0,8,0" />
          </WrapPanel>

          <DataGrid x:Name="LinesGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding Lignes}"
                    SelectedItem="{Binding SelectedLigne}"
                    AutoGenerateColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Réf."
                                  Binding="{Binding ProduitId}"
                                  Width="80"
                                  IsReadOnly="True" />
              <DataGridTextColumn Header="Désignation"
                                  Binding="{Binding Designation}"
                                  Width="*" />
              <DataGridTextColumn Header="Qté"
                                  Binding="{Binding Quantite}"
                                  Width="80" />
              <DataGridTextColumn Header="Prix HT"
                                  Binding="{Binding PrixUnitaireHt}"
                                  Width="100" />
              <DataGridTextColumn Header="Remise"
                                  Binding="{Binding Remise}"
                                  Width="80" />
              <DataGridTextColumn Header="TVA %"
                                  Binding="{Binding TauxTva}"
                                  Width="70" />
              <DataGridTextColumn Header="Montant HT"
                                  Binding="{Binding MontantHt, StringFormat=N2}"
                                  Width="110"
                                  IsReadOnly="True" />
              <DataGridTextColumn Header="Montant TTC"
                                  Binding="{Binding MontantTtc, StringFormat=N2}"
                                  Width="110"
                                  IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="*,220" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Note" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Note}"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   Height="80" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Remise globale" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding RemiseGlobale}" />
          <TextBlock Text="{Binding TotalHt, StringFormat=Total HT : {0:N2}}" />
          <TextBlock Text="{Binding TotalTva, StringFormat=TVA : {0:N2}}" />
          <TextBlock Text="{Binding TotalTtc, StringFormat=Total TTC : {0:N2}}"
                     FontWeight="SemiBold"
                     FontSize="16" />
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="4"
                 Text="{Binding ErrorMessage}"
                 Foreground="IndianRed"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}" />
    </Grid>
  </Border>
</UserControl>
