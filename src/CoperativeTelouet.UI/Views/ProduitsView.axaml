<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels"
             x:Class="CoperativeTelouet.UI.Views.ProduitsView"
             x:DataType="vm:ProduitsViewModel">

  <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16" Margin="16" RowDefinitions="*">
    <!-- Liste -->
    <Border Grid.Column="0"
            Padding="16"
            Background="White"
            CornerRadius="8"
            BorderBrush="{DynamicResource BrandBorder}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Nouveau produit"
                  Classes="accent"
                  Command="{Binding NouveauCommand}"
                  Padding="14,8" />
          <Button Content="Export CSV"
                  Command="{Binding ExportCsvCommand}"
                  Padding="14,8" />
          <Button Content="Import CSV"
                  Command="{Binding ImportCsvCommand}"
                  Padding="14,8" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="« Nouveau produit » ouvre une fiche brouillon : rien n'est enregistré en base tant que vous n'avez pas cliqué « Enregistrer la fiche ». Sinon, sélectionnez un produit pour l'éditer."
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   FontSize="12" />

        <TextBox Grid.Row="2"
                 Watermark="Rechercher : réf., nom ou code-barres..."
                 Text="{Binding SearchText}" />

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding PageItems}"
                  SelectedItem="{Binding SelectedItem}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Réf." Binding="{Binding Reference}" Width="120" />
            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*" />
            <DataGridTextColumn Header="Stk" Binding="{Binding StockActuel, StringFormat=N2}" Width="90" />
            <DataGridTextColumn Header="Min" Binding="{Binding StockMinimum, StringFormat=N2}" Width="80" />
          </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4">
          <TextBlock Text="{Binding CountLabel}"
                     VerticalAlignment="Center"
                     Opacity="0.7" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <Button Content="◀"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    Padding="10,4" />
            <TextBlock Text="{Binding PageLabel}"
                       VerticalAlignment="Center"
                       MinWidth="48"
                       TextAlignment="Center" />
            <Button Content="▶"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    Padding="10,4" />
          </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}" />
      </Grid>
    </Border>

    <!-- Fiche -->
    <Border Grid.Column="1"
            Padding="16"
            Background="White"
            CornerRadius="8"
            BorderBrush="{DynamicResource BrandBorder}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <DockPanel>
          <TextBlock Text="{Binding FicheTitle}"
                     FontWeight="SemiBold"
                     FontSize="16"
                     VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Right">
            <Button Content="+"
                    Command="{Binding NouveauCommand}"
                    ToolTip.Tip="Nouveau"
                    Padding="10,4"
                    MinWidth="36" />
            <Button Content="🗑"
                    Command="{Binding DeleteCommand}"
                    ToolTip.Tip="Supprimer"
                    Padding="10,4"
                    MinWidth="36" />
            <Border Width="56"
                    Height="56"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource BrandBorder}"
                    BorderThickness="1"
                    Background="#F5F5F5">
              <TextBlock Text="IMG"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0.45"
                         FontSize="11" />
            </Border>
          </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Référence" Opacity="0.7" FontSize="12" />
                <TextBox Text="{Binding Reference}" Watermark="Ex. ART-001" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBlock Text="Désignation" Opacity="0.7" FontSize="12" />
                <TextBox Text="{Binding Designation}" Watermark="Libellé" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Text="Code-barres (EAN / UPC)" Opacity="0.7" FontSize="12" />
                <TextBox Text="{Binding CodeBarre}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                <TextBlock Text="Unité" Opacity="0.7" FontSize="12" />
                <TextBox Text="{Binding Unite}" Watermark="U" Width="80" HorizontalAlignment="Left" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                <TextBlock Text="Stock actuel (lecture seule)" Opacity="0.7" FontSize="12" />
                <TextBox Text="{Binding StockActuel, StringFormat=N2}" IsReadOnly="True" Opacity="0.85" />
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                <TextBlock Text="Prix achat HT" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding PrixAchatHt}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                <TextBlock Text="Prix vente HT" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding PrixVenteHt}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>

              <StackPanel Grid.Row="4" Grid.Column="0" Spacing="4">
                <TextBlock Text="Prix achat TTC" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding PrixAchatTtc}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                <TextBlock Text="Prix vente TTC" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding PrixVenteTtc}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>

              <StackPanel Grid.Row="5" Grid.Column="0" Spacing="4">
                <TextBlock Text="TVA %" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding TauxTva}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                <TextBlock Text="Stock minimum" Opacity="0.7" FontSize="12" />
                <NumericUpDown Value="{Binding StockMinimum}" FormatString="N2" Minimum="0" Increment="0.01" />
              </StackPanel>
            </Grid>

            <CheckBox Content="Produit actif (visible dans les documents)"
                      IsChecked="{Binding Actif}"
                      Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Enregistrer la fiche"
                  Classes="accent-green"
                  Command="{Binding SaveCommand}"
                  Padding="16,8" />
          <Button Content="Supprimer le produit"
                  Command="{Binding DeleteCommand}"
                  Padding="16,8" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
