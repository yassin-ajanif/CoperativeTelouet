<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels.Vente.Clients"
             x:Class="CoperativeTelouet.UI.Views.Vente.Clients.ClientsView"
             x:DataType="vm:ClientsViewModel">
  <Border Margin="16" Padding="24" Background="White" CornerRadius="8"
          BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
               Foreground="{DynamicResource BrandBlack}" />
  </Border>
</UserControl>
