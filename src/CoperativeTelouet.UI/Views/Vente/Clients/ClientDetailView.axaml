<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoperativeTelouet.UI.ViewModels.Vente.Clients"
             xmlns:conv="using:CoperativeTelouet.UI.Converters"
             x:Class="CoperativeTelouet.UI.Views.Vente.Clients.ClientDetailView"
             x:DataType="vm:ClientDetailViewModel">

  <Grid Margin="16" ColumnDefinitions="320,*" ColumnSpacing="16">
    <!-- Form -->
    <Border Grid.Column="0"
            Padding="16"
            Background="White"
            CornerRadius="8"
            BorderBrush="{DynamicResource BrandBorder}"
            BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Button Content="Retour liste"
                  Command="{Binding RetourListeCommand}"
                  HorizontalAlignment="Left"
                  Padding="12,6" />

          <TextBlock Text="Type" Opacity="0.7" FontSize="12" />
          <ComboBox ItemsSource="{Binding TypeOptions}"
                    SelectedItem="{Binding SelectedType}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static conv:TypeTiersOptionConverter.Instance}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="Nom" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Nom}" Watermark="Nom" />

          <TextBlock Text="ICE" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Ice}" Watermark="ICE" />

          <TextBlock Text="Adresse" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Adresse}" Watermark="Adresse" />

          <TextBlock Text="Ville" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Ville}" Watermark="Ville" />

          <TextBlock Text="Téléphone" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Telephone}" Watermark="Téléphone" />

          <TextBlock Text="Email" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding Email}" Watermark="Email" />

          <TextBlock Text="Conditions paiement" Opacity="0.7" FontSize="12" />
          <TextBox Text="{Binding ConditionsPaiement}" Watermark="Conditions paiement" />

          <CheckBox Content="Actif" IsChecked="{Binding Actif}" />

          <Button Content="Enregistrer"
                  Classes="accent"
                  Command="{Binding SaveCommand}"
                  HorizontalAlignment="Stretch"
                  Padding="12,8"
                  Margin="0,8,0,0" />

          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="IndianRed"
                     TextWrapping="Wrap"
                     IsVisible="{Binding HasError}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Compte -->
    <Border Grid.Column="1"
            Padding="16"
            Background="White"
            CornerRadius="8"
            BorderBrush="{DynamicResource BrandBorder}"
            BorderThickness="1"
            IsVisible="{Binding ShowCompte}">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <DockPanel Grid.Row="0">
          <TextBlock Text="État factures et règlements"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource BrandBlack}"
                     VerticalAlignment="Center" />
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <Border Background="{DynamicResource BrandRed}"
                    CornerRadius="6"
                    Padding="12,6">
              <TextBlock Text="{Binding SoldeLabel}"
                         Foreground="White"
                         FontWeight="SemiBold" />
            </Border>
            <Button Content="PDF"
                    Command="{Binding ExportPdfCommand}"
                    Padding="12,6" />
          </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CompteLignes}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Date"
                                Binding="{Binding Date, StringFormat=\{0:dd/MM/yyyy\}}"
                                Width="100" />
            <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*" />
            <DataGridTextColumn Header="Observation" Binding="{Binding Observation}" Width="120" />
            <DataGridTextColumn Header="Débit"
                                Binding="{Binding Debit, Converter={x:Static conv:DecimalDhConverter.Instance}}"
                                Width="110" />
            <DataGridTextColumn Header="Crédit"
                                Binding="{Binding Credit, Converter={x:Static conv:DecimalDhConverter.Instance}}"
                                Width="110" />
            <DataGridTextColumn Header="Solde"
                                Binding="{Binding Solde, Converter={x:Static conv:DecimalDhConverter.Instance}}"
                                Width="110" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
